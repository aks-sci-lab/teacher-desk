{
  "manifest_version": 3,
  "name": "업무 데스크로 보내기",
  "version": "0.3.1",
  "description": "에듀파인·나이스 화면에서 단축키를 누르면 지금 보이는 글을 이 PC 의 업무 데스크로만 보내고, 업무 데스크에서 정한 값을 나이스 입력 칸에 채웁니다(저장은 직접).",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.use.go.kr/*",
    "https://*.neis.go.kr/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "업무 데스크로 보내기",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "commands": {
    "send-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "지금 화면을 업무 데스크로 보내기"
    },
    "fill-page": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "업무 데스크의 나이스 채우기 요청을 지금 확인"
    }
  }
}
