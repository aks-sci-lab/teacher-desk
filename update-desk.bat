@echo off
rem 이 파일은 tools/make_bats.py 가 만듭니다 (직접 고치지 말고 스크립트를 고치세요).
rem 한국어 윈도우에서 한글 안내가 깨지지 않도록 ANSI(CP949)로 저장되어 있습니다.
rem  update-desk.bat /y  : 묻지 않고 바로 업데이트 (자동 시험용)
title 업무 데스크 업데이트
cd /d "%~dp0"
set "DESK_DIR=%~dp0"

if /i not "%~1"=="/y" (
    echo.
    echo  업무 데스크를 최신 버전으로 바꿉니다.
    echo  - 학생 명단·발급 기록·수신함 자료와 설정은 그대로 남습니다.
    echo  - 먼저 업무 데스크 검은 창을 닫아 주세요.
    echo.
    pause
)

powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
if errorlevel 1 (
    echo.
    echo  [오류] 업데이트하지 못했습니다. 인터넷 연결과 업무 데스크 창이 닫혔는지 확인하세요.
    echo  그래도 안 되면 이 창을 사진으로 찍어 보내 주세요.
    if /i not "%~1"=="/y" pause
    exit /b 1
)
echo.
echo  업데이트를 마쳤습니다. start-desk.bat 으로 다시 켜세요.
if /i not "%~1"=="/y" pause
